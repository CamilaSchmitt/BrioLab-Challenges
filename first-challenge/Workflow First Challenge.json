    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const task = item.json;\n\n  const customFields = {};\n\n  for (const field of task.custom_fields || []) {\n    customFields[field.name] = field.value;\n  }\n\n  return {\n    json: {\n      taskId: task.id,\n      nome: task.name,\n      descricao: task.description,\n      status: task.status?.status,\n\n      legenda: customFields[\"Legenda\"],\n      dataPostagem: customFields[\"Data de postagem\"]\n        ? new Date(Number(customFields[\"Data de postagem\"]))\n            .toISOString()\n            .split(\"T\")[0]\n        : null,\n      tipoConteudo: customFields[\"Tipo de conteúdo\"],\n    }\n  };\n});"
      },
